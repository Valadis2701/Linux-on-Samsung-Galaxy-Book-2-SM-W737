#!/usr/bin/env python3
"""Brightness window for the internal AMOLED panel of the Galaxy Book2 (SM-W737).

A 0..100 slider whose value is passed to /usr/local/sbin/w737-brightness-set,
which builds the TCON payload and writes it to the panel via /dev/drm_dp_aux0.

A plain GTK3 window — no framebuffer tricks and no virtual terminal switching.
"""
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

SETTER = "/usr/local/sbin/w737-brightness-set"
STATE = "/var/lib/w737-brightness/level"
DEBOUNCE_MS = 300


def read_saved_level(default=50):
    try:
        with open(STATE, "r", encoding="ascii") as fh:
            return max(0, min(100, int(fh.read().strip())))
    except Exception:
        return default


class BrightnessWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Screen brightness — Galaxy Book2")
        self.set_default_size(620, 260)
        self.set_border_width(26)
        self.set_position(Gtk.WindowPosition.CENTER)

        self._pending = None
        self._last = None

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.add(outer)

        self.value_label = Gtk.Label()
        self.value_label.set_xalign(0.5)
        outer.pack_start(self.value_label, False, False, 0)

        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        for mark in (0, 25, 50, 75, 100):
            self.scale.add_mark(mark, Gtk.PositionType.BOTTOM, str(mark))
        self.scale.connect("value-changed", self._on_value_changed)
        outer.pack_start(self.scale, False, False, 0)

        self.status = Gtk.Label()
        self.status.set_xalign(0.5)
        outer.pack_start(self.status, False, False, 0)

        hint = Gtk.Label()
        hint.set_markup(
            "<small>The level is saved and restored at boot\n"
            "(w737-brightness.service)</small>")
        hint.set_xalign(0.5)
        hint.set_opacity(0.6)
        outer.pack_start(hint, False, False, 0)

        level = read_saved_level()
        self.scale.set_value(level)
        self._last = level
        self._update_label(level)
        self.status.set_text("current level: %d" % level)

        self.connect("destroy", Gtk.main_quit)

    def _update_label(self, level):
        self.value_label.set_markup(
            "<span size='46000' weight='bold'>%d</span>" % int(level))

    def _on_value_changed(self, scale):
        level = int(scale.get_value())
        self._update_label(level)
        if self._pending is not None:
            GLib.source_remove(self._pending)
        self._pending = GLib.timeout_add(DEBOUNCE_MS, self._apply, level)

    def _apply(self, level):
        self._pending = None
        if level == self._last:
            return False
        self._last = level
        try:
            subprocess.Popen([SETTER, str(level)],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.PIPE)
            self.status.set_text("sent: %d" % level)
        except Exception as exc:  # noqa: BLE001
            self.status.set_text("error: %s" % exc)
        return False


def main():
    if not os.path.exists(SETTER):
        print("%s not found" % SETTER, file=sys.stderr)
        return 1
    win = BrightnessWindow()
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
