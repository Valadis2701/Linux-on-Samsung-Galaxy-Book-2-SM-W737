#!/bin/sh
# w737-brightness-set [LEVEL]
# Sets the internal AMOLED brightness (0..100). With no argument re-applies the
# last saved level, which is what the boot unit does.
#
# If w737-brightnessd is running it keeps the panel calibration in memory and
# this is just a one-line hand-off; otherwise fall back to a full one-shot run.
set -e
STATE=/var/lib/w737-brightness/level
RUN=/run/w737-brightness
BIN=/usr/local/sbin/w737-brightness
LOG=/var/log/w737-brightness.log

if [ -n "$1" ]; then
    lvl=$1
else
    if [ -r "$STATE" ]; then
        lvl=$(cat "$STATE")
    else
        lvl=50
    fi
fi

case "$lvl" in
    ''|*[!0-9]*) echo "w737-brightness-set: level must be 0..100" >&2; exit 2 ;;
esac
[ "$lvl" -gt 100 ] && lvl=100

mkdir -p /var/lib/w737-brightness 2>/dev/null || true
printf '%s\n' "$lvl" > "$STATE" 2>/dev/null || true

if [ -e "$RUN/ready" ] && [ -w "$RUN/request" ]; then
    printf '%s\n' "$lvl" > "$RUN/request"
    exit 0
fi

# Daemon absent: pay the full initialisation, and pin fd 0 because the kernel
# shim runs us with stdin closed (open() would otherwise return 0).
exec "$BIN" "$lvl" 1 3 0 </dev/null >>"$LOG" 2>&1
